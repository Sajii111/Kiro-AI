# Copy this file to `.env.local` and change only what you need. (`.env.local` is ignored by Git.)
#
# Nothing in here is secret. Every VITE_ value is bundled into the page the browser downloads, so anyone can read it.
# Real secrets (the language-model key, Firebase service-account credentials) belong on the backend only.

# true  (default) = the app runs on built-in sample data. No backend needed.
# false           = the app calls the backend described in docs/API_CONTRACT.md (the one in backend/).
# You only need this line for `npm run dev` against the real server. run.bat builds the site with
# `npm run build:server`, which sets it to false for you (see vite.config.ts).
VITE_USE_MOCK=true

# Where the backend lives when VITE_USE_MOCK=false.
#   (empty)                  Same address as this site. In development, Vite forwards /v1 calls to DEV_API_TARGET
#                            below. In production, the backend serves this built site itself (see the README).
#   https://api.example.com  A separate server. It must allow this site's address with credentials (CORS).
VITE_API_URL=

# Development only. Where `npm run dev` and `npm run preview` forward /v1 calls when VITE_API_URL is empty.
# DEV_API_TARGET=http://127.0.0.1:8000

# How many minutes a guest session lasts before its temporary data is cleared. Default 120.
# Set it to 1 to show guest expiry quickly in a demonstration.
# VITE_GUEST_SESSION_MINUTES=120
