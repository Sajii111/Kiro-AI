# Optional settings for the server. You do NOT need this file to run the project on your own computer, except for one line if
# you want Gemini to write the report text and the chat answers (see the Gemini section below).
#
# To change something: copy this file to `.env` in the same folder, remove the # in front of the line you want, and
# restart the server. `.env` is ignored by Git. Never commit it, and never paste its contents into a chat or a report.
# A real environment variable always wins over this file.

# development (default) or production. In production the cookies are sent only over HTTPS and /v1/docs is switched off.
# APP_ENV=development

# Where the server listens. Keep 127.0.0.1 so only this computer can reach it.
# HOST=127.0.0.1
# PORT=8000

# The built website that the server hands out (default: the dist-server folder next to package.json).
# SITE_DIR=

# Minutes a guest session lasts before its temporary data is deleted (default 120).
# Use 1 to show guest expiry quickly in a demonstration.
# GUEST_SESSION_MINUTES=120

# Days a sign-in lasts (default 14).
# SIGNIN_DAYS=14

# A short pause between the steps of a reading, in milliseconds, so each step is readable on screen (default 450).
# STAGE_PAUSE_MS=450

# The biggest photo in megabytes, and the most pixels a photo may have once opened (default 15 and 24000000).
# MAX_PHOTO_MB=15
# MAX_PIXELS=24000000

# How photos are analysed.
#   auto    (default) real analysis when the hand model is installed, otherwise clearly labelled sample readings
#   real    real analysis only: the server refuses to start if the hand model is missing
#   sample  always sample readings, never looks at a photo's content
# ANALYSIS_MODE=auto
# Where the hand model file is (default: backend\models\hand_landmarker.task, which `run.bat models` downloads).
# HAND_MODEL=

# ---- Gemini: writes the report text and the chat answers ----
# The free key from Google AI Studio: https://aistudio.google.com/apikey  (do NOT turn on billing).
# Without a key everything still works: the fixed wording from the knowledge base writes it all, and the reading says so.
# Put the key HERE and nowhere else: never in a chat, a report, a screenshot or a commit. No quotes, no spaces.
# What Google gets: only the findings as words (for example "heart line: long, gentle curve") and your chat questions with
# names, e-mail addresses, phone numbers and links removed. Never a photo. On the free tier Google may use what it receives to
# improve its products, and people may read it.
# After you save the key, run   run.bat gemini   once to check it.
# GEMINI_API_KEY=

# Which model writes the words (default gemini-3.5-flash-lite, a quick one). You may name several, separated by commas: they are
# tried in that order, and the first that can answer does. `run.bat gemini --probe` shows which models work for your key.
# GEMINI_MODEL=gemini-3.5-flash-lite

# The models that take over, in this order, when the one above is busy or its free allowance is used up. Google's "high
# demand" answer and its free allowances belong to each model separately, so another model of the same key usually still
# answers. The two Gemma 4 models are served by the same Gemini API with the same key. Nothing but Google's Gemini API and your
# one key is involved. Write none to use only GEMINI_MODEL.
# GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemma-4-31b-it,gemma-4-26b-a4b-it

# The first time a question is asked, the app asks Google which models your key may use (one quick request): a model that is not
# offered is left out, so a name that Google retired costs nothing, and up to three more Flash models from the list are added after
# the others. Write 0 to use exactly the models named above and never ask.
# GEMINI_DISCOVER=1

# How much the model may think before it answers: MINIMAL, LOW, MEDIUM or HIGH. Empty leaves the model's own default.
# Try LOW if `run.bat gemini` says an answer was cut off.
# GEMINI_THINKING=

# The longest a report waits for Gemini, in seconds (default 150), all the models and the repeats together: when Google says "busy",
# the report waits a little and asks every model again, up to eight times. A chat answer waits half as long, at most 45 seconds.
# GEMINI_TIMEOUT_SECONDS=150

# How many Gemini-written chat answers one session may have (default 40). After that the fixed wording answers.
# GEMINI_CHAT_LIMIT=40

# The most requests to Gemini in one minute, so a free key's per-minute allowance is not used up (default 12).
# GEMINI_MAX_PER_MINUTE=12

# How many identical report requests are remembered, so the same findings are not asked for twice (default 32, 0 = none).
# GEMINI_CACHE_SIZE=32

# ---- Where accounts are kept (Cloud Firestore) ----
# With the Firebase key at backend\secrets\firebase-service-account.json, accounts and everything they own (hand profiles,
# readings, chats) are saved in your Firebase project's Firestore database, so they are still there after a restart. Never a
# photo, and guest sessions are never saved. Without the key they live in the server's memory until it stops.
# Check the key and the database with   run.bat firebase   (the README says how to make the key).
#   auto       the database whenever the key file is there (the default)
#   memory     never the database, even with a key
#   firestore  always the database: the server refuses to start without a usable key
# STORAGE=auto

# Where the key file is, if not in backend\secrets\ (a full path). It is a password to your database: never share it.
# FIREBASE_KEY=

# The database, if you gave it its own name when you made it (default: the project's first database, "(default)").
# FIRESTORE_DATABASE=
